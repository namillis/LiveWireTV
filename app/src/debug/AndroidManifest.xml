<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG-only manifest additions. Merged into the debug build's manifest and absent
     from release. Registers the headless self-update trigger used for the emulator
     end-to-end test (see UpdateDebugReceiver). Exported so `adb shell am broadcast`
     can reach it (a non-exported receiver silently drops shell broadcasts), but
     guarded by DUMP, which only the shell and system hold. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <receiver
            android:name=".feature.update.debug.UpdateDebugReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="com.livewire.tv.debug.RUN_UPDATE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
