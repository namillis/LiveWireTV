<?xml version="1.0" encoding="utf-8"?>
<!--
  TextureView-backed PlayerView. A SurfaceView hosted inside Compose layers can end up
  behind the composable's own background, which plays audio over a blank screen.
  surface_type is only settable from XML, hence this layout.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:focusable="false"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:resize_mode="fit"
    app:shutter_background_color="@android:color/black"
    app:keep_content_on_player_reset="false" />
