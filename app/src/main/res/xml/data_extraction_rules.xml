<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ ignores allowBackup for device-to-device transfer, so exclude everything
  explicitly. Provider logins live in encrypted prefs whose key never leaves this device;
  copying them to another device would carry data it cannot decrypt.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
